{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.invalid/feature-document-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "prd",
        "tech-plan"
      ]
    },
    "profile": {
      "enum": [
        "product",
        "implementation"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 100
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "enum": [
        "fr",
        "en"
      ]
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "users": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "successMetrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "preDraft": {
      "type": "object",
      "properties": {
        "reuse": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "sharedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "sourcePriority": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "reuse",
        "sharedSurfaces",
        "sourcePriority"
      ],
      "additionalProperties": false
    },
    "techPlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 100
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "functional",
              "non-functional"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "description",
          "priority",
          "acceptance"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "code",
              "human-qa"
            ]
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 100
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 100
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "planRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 100
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "forbiddenScope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "seedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 100
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "cleanup": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "dependsOn",
          "requirementIds",
          "planRefs",
          "seedIds"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "code"
                }
              }
            },
            "then": {
              "required": [
                "goal",
                "scope",
                "validation"
              ]
            },
            "else": {
              "required": [
                "steps",
                "expected",
                "cleanup"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "scope"
                    ]
                  },
                  {
                    "required": [
                      "validation"
                    ]
                  },
                  {
                    "required": [
                      "goal"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 100
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 100
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "enum": [
              "automated",
              "runtime",
              "manual"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "seedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 100
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "requirementIds",
          "scenario",
          "route",
          "expected",
          "seedIds"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 100
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "cleanup": {
            "type": "string",
            "minLength": 1
          },
          "safety": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "requirementIds",
          "setup",
          "cleanup",
          "safety"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 100
          },
          "kind": {
            "enum": [
              "risk",
              "assumption",
              "question"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "current",
              "reuse",
              "boundary",
              "contract",
              "decision",
              "calculation",
              "flow",
              "rollout",
              "risk"
            ]
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "global": {
            "type": "boolean"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 100
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "consequences": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "diagram": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "body",
          "global",
          "refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "revision",
    "title",
    "summary",
    "locale",
    "constraints"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "prd"
          }
        }
      },
      "then": {
        "required": [
          "profile",
          "requirements",
          "tasks",
          "checks",
          "seeds",
          "risks"
        ],
        "not": {
          "required": [
            "entries"
          ]
        }
      },
      "else": {
        "required": [
          "entries"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "tasks"
              ]
            },
            {
              "required": [
                "requirements"
              ]
            },
            {
              "required": [
                "profile"
              ]
            },
            {
              "required": [
                "techPlan"
              ]
            },
            {
              "required": [
                "checks"
              ]
            },
            {
              "required": [
                "seeds"
              ]
            },
            {
              "required": [
                "risks"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "const": "implementation"
          }
        }
      },
      "then": {
        "required": [
          "techPlan"
        ]
      }
    }
  ]
}
